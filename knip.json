{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "ignore": [".trunk/**"],
  "ignoreDependencies": ["stylelint-config-standard"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs", "e2e/**/*.ts"],
      "project": ["**/*.{js,cjs,mjs,ts,cts,mts}", "!packages/**", "!.trunk/**", "!node_modules/**"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/workshop-web": {
      "entry": ["src/server.ts", "src/styles.css"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
